\MC DESMOND\\dextop\\flutter\\babyhub\\backend\\src\\main\\java\\com\\project\\babyshophub\\backend\\dto\" \"\"\",  \"\"\" ```[ \"\"\"```package com.project.babyshophub.backend.entity;\n\nimport javax.persistence.*;\nimport java.util.ArrayList;\nimport java.util.List;\n\n@Entity\n@Table(name = \"carts\")\npublic class Cart {\n    @Id\n    private int id;\n\n    @OneToOne(fetch = FetchType.LAZY)\n    @JoinColumn(name = \"user_id\", nullable = false, unique = true)\n    private User user;\n\n    @OneToMany(mappedBy = \"cart\", cascade = CascadeType.ALL, orphanRemoval = true)\n    private List<CartItem> cartItems = new ArrayList<>();\n\n    public Cart() {\n    }\n\n    public Cart(User user) {\n        this.user = user;\n    }\n\n    public int getId() {\n        return id;\n    }\n\n    public void setId(int id) {\n        this.id = id;\n    }\n\n    public User getUser() {\n        return user;\n    }\n\n    public void setUser(User user) {\n        this.user = user;\n    }\n\n    public List<CartItem> getCartItems() {\n        return cartItems;\n    }\n\n    public void setCartItems(List<CartItem> cartItems) {\n        this.cartItems = cartItems;\n    }\n\n    public void addCartItem(CartItem cartItem) {\n        if (cartItem != null && !cartItems.contains(cartItem)) {\n            cartItems.add(cartItem);\n            cartItem.setCart(this);\n        }\n    }\n\n    public void removeCartItem(CartItem cartItem) {\n        if (cartItem != null && cartItems.contains(cartItem)) {\n            cartItems.remove(cartItem);\n            cartItem.setCart(null);\n        }\n    }\n}``` from file \"C:\\Users\\MC DESMOND\\dextop\\flutter\\babyhub\\backend\\src\\main\\java\\com\\project\\babyshophub\\backend\\entity\\Cart.java\" \"\"\",  \"\"\"```package com.project.babyshophub.backend.entity;\n\nimport javax.persistence.*;\n\n@Entity\n@Table(name = \"cart_items\")\npublic class CartItem {\n    @Id\n    private int id;\n\n    @ManyToOne(fetch = FetchType.LAZY)\n    @JoinColum